# ============================================================
# EQUI Gaming Platform — Git Ignore Configuration
# ============================================================

# --- Next.js / Node ---
node_modules/
.next/
out/
build/
dist/

# --- Environment & Keys ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Logs & Cache ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Vercel ---
.vercel

# --- Laravel Backend ---
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*
!backend/storage/framework/.gitignore
!backend/storage/logs/.gitignore

# --- IDEs & Editors ---
.idea/
.vscode/
*.suo
*.user
*.userosql
*.sln
*.swp
